# Kopieer naar .env.local (in de hoofdmap; website én app lezen dit bestand) en vul in met de gegevens van je Supabase-project
# (Supabase dashboard → Project Settings → API Keys / Data API).
#
# Beide waarden zijn publiek: toegang tot data wordt afgedwongen met Row Level Security.
# Zet hier NOOIT de service_role/secret key.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
